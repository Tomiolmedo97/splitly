# Copiar a apps/web/.env.local y completar. NUNCA commitear valores reales.
# Solo placeholders: en Vercel las variables se cargan desde el dashboard / integración de Neon.

# Neon Postgres 17 (sa-east-1). Conexión CON pooler (host con "-pooler"): la usa la app.
DATABASE_URL="postgresql://USUARIO:CONTRASEÑA@HOST-pooler.sa-east-1.aws.neon.tech/splitly?sslmode=require"
# Conexión DIRECTA (sin pooler): la usa Prisma para migraciones (prisma migrate deploy).
DIRECT_URL="postgresql://USUARIO:CONTRASEÑA@HOST.sa-east-1.aws.neon.tech/splitly?sslmode=require"

# Secreto de Auth.js (mínimo 32 caracteres). Generalo con: openssl rand -base64 32
AUTH_SECRET=

# Pública (llega al navegador): NUNCA poner secretos en variables NEXT_PUBLIC_.
NEXT_PUBLIC_APP_URL=http://localhost:3000
